void readLux() {
  if (millis() - tLux < LUX_INTERVAL) return;
  tLux = millis();
  float v = bh1750.readLightLevel();
  if (v >= 0 && v < 65535) luxValue = v;
  Serial.printf("Lux: %.1f\n", luxValue);
}

// Таблица напряжение->процент для свинцово-кислотного 12V (Solomon)
int voltageToPercent(float v) {
  if (v >= 12.70f) return 100;
  if (v >= 12.60f) return 95;
  if (v >= 12.50f) return 90;
  if (v >= 12.40f) return 80;
  if (v >= 12.30f) return 70;
  if (v >= 12.20f) return 60;
  if (v >= 12.10f) return 50;
  if (v >= 12.00f) return 40;
  if (v >= 11.90f) return 30;
  if (v >= 11.80f) return 20;
  if (v >= 11.70f) return 10;
  if (v >= 11.60f) return  5;
  return 0;
}

void readBattery() {
  if (millis() - tBatt < BATT_INTERVAL) return;
  tBatt = millis();

  if (!adsFound) {
    Serial.println("Batt: ADS1115 не подключён");
    return;
  }

  int16_t raw = ads.readADC_SingleEnded(0);
  if (raw < 0) raw = 0;
  float adc        = raw * 0.0001250f;          // GAIN_ONE: 1 LSB = 0.125mV
  float rawVoltage = adc * BATT_DIVIDER_RATIO;

  if (battVoltage < 1.0f) battVoltage = rawVoltage;
  else battVoltage = battVoltage * 0.95f + rawVoltage * 0.05f;

  battPercent = voltageToPercent(battVoltage);
  Serial.printf("Batt: %.2fV %d%% [%s] | LED: %d/255\n",
    battVoltage, battPercent,
    battChargeMode == 1 ? "АВТО" : "РУЧНОЙ",
    brightness);

  // Авто-логика работает только в режиме battChargeMode == 1
  if (battChargeMode == 1) {

    // Автопереключение источника питания
    if (battPercent < lowBattThreshold && !powerFromMains) {
      powerFromMains = true;
      digitalWrite(RELAY_PIN, HIGH);
      Serial.printf("[RELAY AUTO] АКБ < %d%% -> розетка\n", lowBattThreshold);
    } else if (battPercent > (lowBattThreshold + 5) && powerFromMains) {
      powerFromMains = false;
      digitalWrite(RELAY_PIN, LOW);
      Serial.printf("[RELAY AUTO] АКБ > %d%% -> АКБ\n", lowBattThreshold + 5);
    }

    // Автозарядка (только если autoSolarCharge включён)
    if (autoSolarCharge) {
      if (battPercent < lowBattThreshold && !isCharging) {
        isCharging = true;
        digitalWrite(CHARGE_PIN, LOW);   // LOW = вкл (активное LOW реле)
        Serial.printf("[CHARGE AUTO] АКБ < %d%% -> зарядка ВКЛ\n", lowBattThreshold);
      } else if (battPercent >= fullBattThreshold && isCharging) {
        isCharging = false;
        digitalWrite(CHARGE_PIN, HIGH);  // HIGH = выкл
        Serial.printf("[CHARGE AUTO] АКБ >= %d%% -> зарядка ВЫКЛ\n", fullBattThreshold);
      }
    }
  }
  // В ручном режиме реле и зарядка управляются только через MQTT/HTTP
}

void readMotion() {
  int reading = digitalRead(MOTION_PIN);
  if (reading != motionPinLast) tDebounce = millis();
  motionPinLast = reading;
  if (millis() - tDebounce > DEBOUNCE_MS && reading != motionPinStable) {
    motionPinStable = reading;
    if (motionPinStable == HIGH && !motionActive) {
      motionActive = true;
      tMotionLast  = millis();
      Serial.println("Движение: ДА");
    }
  }
  if (motionPinStable == HIGH) tMotionLast = millis();
  if (motionActive && millis() - tMotionLast > MOTION_TIMEOUT) {
    motionActive = false;
    Serial.println("Движение: таймаут");
  }
}

// ===================================================
//  БЛОК 3: РАСПИСАНИЕ
// ===================================================

void getTime(int &h, int &m) {
  struct tm t;
  if (!getLocalTime(&t)) { h = -1; m = -1; return; }
  h = t.tm_hour; m = t.tm_min;
}

bool scheduleIsActive() {
  int h, m;
  getTime(h, m);
  if (h == -1) { Serial.println("NTP не синхронизирован"); return false; }
  int now = h * 60 + m;
  for (int i = 0; i < scheduleCount; i++) {
    if (!schedules[i].enabled) continue;
    int on  = schedules[i].onHour  * 60 + schedules[i].onMinute;
    int off = schedules[i].offHour * 60 + schedules[i].offMinute;
    bool active = (on > off) ? (now >= on || now < off) : (now >= on && now < off);
    if (active) return true;
  }
  return false;
}

void checkSchedule() {
  if (millis() - tSchedCheck < SCHED_INTERVAL) return;
  tSchedCheck     = millis();
  prevSchedActive = schedActive;
  schedActive     = scheduleIsActive();
  int h, m; getTime(h, m);
  if (h != -1)
    Serial.printf("Время: %02d:%02d | Расписание: %s\n", h, m, schedActive ? "АКТИВНО" : "НЕТ");
  if (prevSchedActive && !schedActive) {
    lastAutoBright = -1;
    ledSmooth(0, false);
    ledOn = false;
    Serial.println("Расписание закончилось");
  }
}

// ===================================================
//  БЛОК 4: АВТО-ЯРКОСТЬ
// ===================================================

int calcAutoBright() {
  if (!motionActive)   return 0;
  if (luxValue >= 400) return 0;
  if (luxValue >= 200) return 70;
  if (luxValue >= 100) return 130;
  if (luxValue >= 50)  return 200;
  return 255;
}

void runAutoSensors() {
  readMotion();
  int target = calcAutoBright();
  if (target == lastAutoBright) return;
  lastAutoBright = target;
  if (target > 0) {
    ledOn = true;
    ledSmooth(target, true);
    Serial.printf("Авто вкл: %d (Lux=%.1f)\n", target, luxValue);
  } else {
    ledOn = false;
    ledSmooth(0, false);
    Serial.printf("Авто выкл (Lux=%.1f)\n", luxValue);
  }
}

// ===================================================
//  БЛОК 5: MQTT — ПУБЛИКАЦИЯ
