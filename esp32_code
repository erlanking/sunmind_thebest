// ===================================================
//  БЛОК 1: УПРАВЛЕНИЕ СВЕТОДИОДОМ
// ===================================================

void ledWrite(int val) {
  analogWrite(LED_PIN, constrain(val, 0, 255));
}

void ledSet(int val, bool save = true) {
  val = constrain(val, 0, 255);
  brightness = val;
  if (save && val > 0) savedBright = val;
  ledWrite(val);
  ledOn = (val > 0);
}

void ledSmooth(int target, bool save = true) {
  target = constrain(target, 0, 255);
  if (target == brightness) return;
  int step = (target > brightness) ? 5 : -5;
  for (int i = brightness; (step > 0) ? (i <= target) : (i >= target); i += step) {
    ledWrite(i);
    delay(8);
  }
  brightness = target;
  if (save && target > 0) savedBright = target;
  ledOn = (target > 0);
}

void ledApply() {
  if (ledOn) {
    if (savedBright <= 0) savedBright = 255;
    ledSet(savedBright, false);
  } else {
    ledSet(0, false);
  }
}

